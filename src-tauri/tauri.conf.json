{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Audio Manager",
  "version": "0.1.0",
  "identifier": "com.digitalaudiomanager.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Digital Audio Manager", "width": 1440, "height": 920, "minWidth": 1024, "minHeight": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["../python/worker.py", "../python/vendor"]
  }
}
